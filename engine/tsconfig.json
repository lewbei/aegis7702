{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "outDir": "./dist"
  },
  "include": [
    "src/capability/**/*",
    "src/search/**/*",
    "src/semantics/**/*",
    "src/recovery/**/*",
    "src/baseline/**/*",
    "src/reachability.ts"
  ]
}
